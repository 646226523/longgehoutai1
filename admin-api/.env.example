# 后台管理系统后端配置

# 服务端口
PORT=3015

# JWT 密钥(生产环境请使用强随机字符串并通过环境变量注入)
JWT_SECRET=longge-admin-jwt-secret-change-in-production-2024
JWT_REFRESH_SECRET=longge-admin-jwt-refresh-secret-change-in-production-2024

# Access Token 有效期(2 小时)
JWT_EXPIRES_IN=2h
# Refresh Token 有效期(7 天)
JWT_REFRESH_EXPIRES_IN=7d

# 默认超管账号(仅在首次初始化时使用)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
